# Rename this to .env. Never commit your actual .env or notification credentials.
ZIP_CODES=01609,02116,02467,02026
# 01609 + Boston/Chestnut Hill/Dedham ZIPs help Apple's nearby-store feed include all 5 stores.
# Target a ~20-second check interval on a continuously running computer.
# This does not guarantee a <30-second alert or checkout.
POLL_SECONDS=20
PREFERRED_COLOR=Star White
# Create a random ntfy topic (see README). Subscribe in the ntfy phone app.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Optional secondary Telegram push alerts:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# On a Mac, open the Apple product page locally whenever fresh stock appears.
OPEN_BROWSER=false
STATE_PATH=.state/stock.json

# EXPERIMENTAL local Playwright checkout; disabled until you opt in.
# Requires checkout_bot.py login + arm; NEVER enabled in GitHub Actions.
AUTO_CHECKOUT=false

# For an enforced <=60-minute drive from ZIP 01609, configure Google Maps Routes API
# locally ONLY. Traffic-aware ETA must be <=55 minutes (5-min buffer).
# The Routes API requires a Google Cloud project with billing enabled.
GOOGLE_MAPS_API_KEY=
# Optional: replace ZIP center with your own precise starting address locally; NEVER commit.
ORIGIN_ADDRESS=Worcester, MA 01609, USA
