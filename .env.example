# Rename this to .env. Never commit your actual .env or notification credentials.
ZIP_CODES=01609,01760,02116,02467,02026
# Multiple lookup ZIPs help Apple return the five allowed stores; all other stores are ignored.
# Target a ~20-second check interval on a continuously running computer.
# This does not guarantee a <30-second alert or checkout.
POLL_SECONDS=20
PREFERRED_COLOR=Star White
# Create a random ntfy topic (see README). Subscribe in the ntfy phone app.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Optional secondary Telegram push alerts:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Safest mode: use YOUR ALREADY SIGNED-IN Safari or Google Chrome (manual checkout).
# The bot opens the right Apple product page; it never reads passwords or browser cookies.
CHECKOUT_MODE=browser_handoff
BROWSER_APP=Safari
OPEN_BROWSER=true
STATE_PATH=.state/stock.json

# Only used in separately opted-in experimental checkout mode, not browser_handoff.
# Login test: installed regular Google Chrome with its OWN local profile.
# Change to chromium only if you explicitly want to retry Chrome for Testing.
# Never point this bot at your ordinary Chrome profile or Safari cookies.
CHECKOUT_BROWSER=chrome

# EXPERIMENTAL local Playwright checkout; disabled in browser_handoff mode.
# Requires checkout_bot.py login + arm; NEVER enabled in GitHub Actions.
AUTO_CHECKOUT=false

# No Google Maps key needed. Store list is fixed; live driving times are NOT checked.
