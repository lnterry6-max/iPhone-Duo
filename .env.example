# Rename this to .env. Never commit your actual .env or notification credentials.
ZIP_CODES=01609,01760,02116,02467,02026
# Multiple lookup ZIPs help Apple return the five allowed stores; all other stores are ignored.
# Respect Apple's service. Five ZIPs mean five requests per scan.
# Watch mode enforces at least 120 seconds and stops after 3 failed rounds.
# This is NOT a <30-second reservation or purchase guarantee.
POLL_SECONDS=180
PREFERRED_COLOR=Star White
# Create a random ntfy topic (see README). Subscribe in the ntfy phone app.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Optional secondary Telegram push alerts:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Choose how the stock monitor opens a matching device page.
# browser_handoff and chrome_extension only open product tabs; they never pay.
# chrome_auto and experimental are UNVALIDATED purchase modes: do not enable.
CHECKOUT_MODE=browser_handoff
BROWSER_APP=Safari
# For connected Chrome use CHECKOUT_MODE=chrome_extension and BROWSER_APP=Google Chrome
# The extension session must be attached manually before starting this monitor.
OPEN_BROWSER=true
STATE_PATH=.state/stock.json

# Only used by separately opted-in experimental checkout mode; not normal Chrome handoff.
# Login test: installed regular Google Chrome with its OWN local profile.
# Change to chromium only if you explicitly want to retry Chrome for Testing.
# Never point this bot at your ordinary Chrome profile or Safari cookies.
CHECKOUT_BROWSER=chrome

# Keep false. Automatic checkout paths have NOT passed an Apple live checkout test.
# Requires checkout_bot.py login + arm; NEVER enabled in GitHub Actions.
AUTO_CHECKOUT=false

# No Google Maps key needed. Store list is fixed; live driving times are NOT checked.
